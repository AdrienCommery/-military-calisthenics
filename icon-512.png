:root{--bg:#0b0f14;--card:#151b23;--card2:#10161d;--text:#f5f7fa;--muted:#98a2b3;--line:#27303b;--accent:#d6f36a;--danger:#ff7a7a;--safe:#73e2a7;--shadow:0 12px 30px rgba(0,0,0,.25)}*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:linear-gradient(180deg,#0b0f14,#10151c 35%,#0b0f14);color:var(--text);min-height:100vh;padding-bottom:90px}.topbar{display:flex;justify-content:space-between;align-items:center;padding:calc(18px + env(safe-area-inset-top)) 18px 12px;position:sticky;top:0;z-index:20;background:rgba(11,15,20,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.04)}h1,h2,h3,p{margin-top:0}h1{font-size:1.35rem;margin-bottom:0}h2{font-size:1.45rem;margin-bottom:8px}h3{font-size:1.02rem;margin-bottom:8px}.eyebrow{font-size:.7rem;letter-spacing:.15em;font-weight:800;color:var(--accent);margin-bottom:5px}.muted{color:var(--muted)}main{max-width:720px;margin:0 auto;padding:16px}.view{display:none}.view.active{display:block}.card{background:linear-gradient(180deg,var(--card),var(--card2));border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:var(--shadow);margin-bottom:14px}.hero{display:flex;justify-content:space-between;gap:16px;align-items:center}.hero p:last-child{margin-bottom:0;color:var(--muted);line-height:1.45}.hero.compact{display:block}.badge{display:grid;place-items:center;min-width:76px;height:76px;border-radius:50%;border:6px solid rgba(214,243,106,.22);color:var(--accent);font-weight:900;font-size:.8rem}.grid.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.stat span{display:block;color:var(--muted);font-size:.82rem}.stat strong{font-size:2rem;margin-right:5px}.stat small{color:var(--muted)}.section-title{display:flex;justify-content:space-between;align-items:end;gap:10px;margin:8px 2px 12px}.section-title h2,.section-title h3{margin:0}.section-title span{color:var(--muted);font-size:.8rem}.progress{height:10px;background:#202833;border-radius:999px;overflow:hidden}.progress>div{height:100%;width:0;background:var(--accent);transition:.25s}.stack{display:grid;gap:10px}.workout-card{display:flex;justify-content:space-between;align-items:center;background:#10161d;border:1px solid var(--line);border-radius:16px;padding:15px;cursor:pointer}.workout-card.done{border-color:rgba(115,226,167,.45)}.workout-card .left b{display:block;font-size:1rem}.workout-card .left span{color:var(--muted);font-size:.82rem}.workout-card .arrow{font-size:1.4rem;color:var(--accent)}button{font:inherit}.primary,.ghost,.back,.link{border:0;border-radius:14px;padding:12px 14px;font-weight:800}.primary{background:var(--accent);color:#10150b}.ghost{background:#202833;color:var(--text);border:1px solid var(--line)}.back,.link{background:transparent;color:var(--muted);padding-left:0}.hidden{display:none!important}.exercise{background:linear-gradient(180deg,var(--card),var(--card2));border:1px solid var(--line);border-radius:18px;padding:15px}.exercise-top{display:flex;justify-content:space-between;gap:12px}.exercise h3{margin-bottom:4px}.exercise .meta{color:var(--muted);font-size:.82rem}.set-row{display:grid;grid-template-columns:36px 1fr 84px 42px;gap:8px;align-items:center;margin-top:10px}.set-row input{width:100%;background:#0c1117;border:1px solid var(--line);color:var(--text);border-radius:12px;padding:10px}.check{width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:#10161d;color:transparent}.check.checked{background:var(--safe);color:#07120c}.rest{margin-top:10px;width:100%}.sticky-action{position:sticky;bottom:82px;padding-top:8px}.sticky-action .primary{width:100%;box-shadow:0 12px 25px rgba(214,243,106,.18)}.bottomnav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(720px,100%);display:grid;grid-template-columns:repeat(3,1fr);padding:9px 12px calc(9px + env(safe-area-inset-bottom));background:rgba(9,13,18,.94);backdrop-filter:blur(20px);border-top:1px solid var(--line);z-index:30}.bottomnav button{background:transparent;border:0;color:var(--muted);font-size:.75rem;font-weight:700}.bottomnav button span{display:block;font-size:1.25rem;margin-bottom:3px}.bottomnav button.active{color:var(--accent)}.form-grid{display:grid;gap:12px}.form-grid label{display:grid;gap:6px;color:var(--muted);font-size:.82rem}.form-grid input{background:#0c1117;border:1px solid var(--line);color:var(--text);border-radius:14px;padding:13px;font-size:1rem}.history-item{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:8px;padding:12px 0;border-bottom:1px solid var(--line);font-size:.82rem}.history-item:last-child{border-bottom:0}.history-item b{font-size:.86rem}.phase b{color:var(--accent);font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.note ul{padding-left:20px;color:var(--muted);line-height:1.55}dialog{border:0;background:transparent}dialog::backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(5px)}.timer-card{min-width:min(88vw,380px);background:#111821;border:1px solid var(--line);border-radius:24px;padding:26px;text-align:center;color:var(--text)}#timerValue{font-size:4rem;font-weight:900;font-variant-numeric:tabular-nums;margin:14px 0 20px}.timer-actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.timer-actions button{padding:11px 8px}.timer-card .link{margin-top:10px}@media(max-width:420px){.grid.two{grid-template-columns:1fr 1fr}.hero{align-items:flex-start}.badge{min-width:66px;height:66px}.set-row{grid-template-columns:32px 1fr 72px 38px}.history-item{grid-template-columns:1.2fr repeat(3,.9fr)}}
